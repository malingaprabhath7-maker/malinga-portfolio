---
import { ui, profile, projects, journey, skills, certificates, type Lang } from '../data/site';
import { url, page } from '../data/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const featured = projects.filter((p) => p.featured);
const cats = ['all', 'web', 'ai', 'hw', 'study'] as const;
const waLink = 'https://wa.me/' + profile.phone.replace(/\D/g, '');
---
<!-- hero: the name, in both scripts, is the one bold element of the page -->
<section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-14 md:grid-cols-[1.35fr_1fr] md:pt-20">
  <div>
    <p class="mb-6 inline-flex items-center gap-2 rounded-full bg-tea-soft px-3 py-1 text-sm font-medium text-tea">
      <span class="size-2 rounded-full bg-tea" aria-hidden="true"></span>{t.open}
    </p>
    <h1 class="font-display font-extrabold leading-[0.92] tracking-[-0.035em]">
      <span class="hero-line block text-[clamp(3.2rem,9vw,6.6rem)]">Malinga</span>
      <span class="hero-line block text-[clamp(3.2rem,9vw,6.6rem)]">Prabhath</span>
      <span class="hero-line mt-3 block font-sinhala text-[clamp(2rem,5.4vw,3.9rem)] font-extrabold leading-tight tracking-normal text-tea" lang="si">{profile.nameSi}</span>
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed sm:text-xl">{t.heroLine}</p>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">{t.heroNote}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#work" class="btn btn-ink">{t.seeWork}</a>
      <a href={url(profile.cv)} class="btn btn-line" download>{t.downloadCv}</a>
    </div>
    <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
      <li><a class="link" href={profile.github}>GitHub</a></li>
      <li><a class="link" href={profile.linkedin}>LinkedIn</a></li>
      <li><a class="link" href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
  <figure class="mx-auto w-full max-w-sm">
    <div class="relative">
      <div class="absolute inset-0 -z-10 translate-x-4 translate-y-4 rounded-[2rem] bg-turmeric/80" aria-hidden="true"></div>
      <img src={url('images/profile.webp')} alt={profile.name} width="690" height="922" class="aspect-[3/4] w-full rounded-[2rem] object-cover object-top" fetchpriority="high" />
    </div>
    <figcaption class="mt-8 text-sm text-muted">{t.role}</figcaption>
  </figure>
</section>

<!-- featured work -->
<section id="work" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{t.workTitle}</h2>
    <p class="mt-3 max-w-xl text-muted">{t.workIntro}</p>
    <div class="mt-14 space-y-24">
      {featured.map((p, i) => {
        const shot = p.images?.find((im) => !im.phone);
        const phone = p.images?.find((im) => im.phone);
        return (
          <article class={`grid items-center gap-10 lg:grid-cols-[1.25fr_1fr] ${i % 2 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
            <a href={page(lang, `projects/${p.slug}`)} class="relative block pb-10 pr-10" aria-label={p.name}>
              <div class="overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_30px_60px_-30px_rgba(20,33,28,.45)]">
                <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
                </div>
                {shot && <img src={url(shot.src)} alt={shot.alt} loading="lazy" width="1600" height="1000" class="w-full" />}
              </div>
              {phone && <img src={url(phone.src)} alt={phone.alt} loading="lazy" width="700" height="1515" class="absolute bottom-0 right-0 w-[26%] rounded-[1.4rem] border-4 border-ink shadow-xl" />}
            </a>
            <div>
              <p class="text-sm font-semibold text-tea">{p.year}</p>
              <h3 class="mt-1 font-display text-3xl font-bold tracking-tight">{p.name}</h3>
              <p class="mt-4 text-lg leading-relaxed">{p[lang].summary}</p>
              {p[lang].problem && <p class="mt-3 leading-relaxed text-muted">{p[lang].problem}</p>}
              <ul class="mt-5 flex flex-wrap gap-1.5">{p.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}</ul>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href={page(lang, `projects/${p.slug}`)} class="btn btn-ink">{t.readCase}</a>
                {p.live && <a href={p.live} class="btn btn-line">{t.liveSite}</a>}
                {p.repo && <a href={p.repo} class="btn btn-line">{t.code}</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- all projects as an index -->
<section id="projects" class="mx-auto max-w-6xl px-5 py-20">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <h2 class="font-display text-4xl font-bold tracking-tight">{t.allTitle}</h2>
      <p class="mt-3 max-w-xl text-muted">{t.allIntro}</p>
    </div>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label={t.allTitle} data-filters>
      {cats.map((c, i) => (
        <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}
          class="rounded-full border border-line px-3.5 py-1.5 text-sm font-medium aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">{t.filters[c]}</button>
      ))}
    </div>
  </div>
  <ul class="mt-10 border-t border-line">
    {projects.map((p) => (
      <li data-cat={p.category} class="grid gap-x-6 gap-y-2 border-b border-line py-5 sm:grid-cols-[4rem_1fr_auto]">
        <span class="text-sm tabular-nums text-muted">{p.year}</span>
        <div>
          <h3 class="font-display text-xl font-bold tracking-tight">
            {p[lang].features || p.images ? <a class="hover:text-tea" href={page(lang, `projects/${p.slug}`)}>{p.name}</a> : p.name}
          </h3>
          <p class="mt-1 max-w-2xl leading-relaxed text-muted">{p[lang].summary}</p>
          {p[lang].status && <p class="mt-1 text-sm font-medium text-indigo">{p[lang].status}</p>}
          {p.stack.length > 0 && <ul class="mt-3 flex flex-wrap gap-1.5">{p.stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}</ul>}
        </div>
        <div class="flex items-start gap-4 text-sm font-medium sm:justify-end">
          {p.live && <a class="link" href={p.live}>{t.liveSite}</a>}
          {p.repo ? <a class="link" href={p.repo}>GitHub</a> : <span class="text-muted">{t.noLink}</span>}
        </div>
      </li>
    ))}
  </ul>
</section>

<!-- journey is a real sequence, so it reads top to bottom by year -->
<section id="journey" class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-[1fr_2fr]">
    <h2 class="font-display text-4xl font-bold tracking-tight">{t.journeyTitle}</h2>
    <ol class="relative border-l-2 border-tea-soft">
      {journey[lang].map((j) => (
        <li class="relative pb-8 pl-7 last:pb-0">
          <span class="absolute -left-[7px] top-1.5 size-3 rounded-full border-2 border-surface bg-tea" aria-hidden="true"></span>
          <p class="text-sm font-semibold text-tea">{j.when}</p>
          <p class="mt-0.5 font-display text-lg font-bold">{j.what}</p>
          <p class="text-muted">{j.where}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="skills" class="mx-auto max-w-6xl px-5 py-20">
  <h2 class="font-display text-4xl font-bold tracking-tight">{t.skillsTitle}</h2>
  <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {skills[lang].map((g) => (
      <div>
        <h3 class="border-b border-line pb-2 font-display text-lg font-bold">{g.group}</h3>
        <p class="mt-3 leading-loose text-muted">{g.items.join(', ')}</p>
      </div>
    ))}
  </div>
</section>

<section id="certificates" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="font-display text-4xl font-bold tracking-tight">{t.certsTitle}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {certificates.map((c) => (
        <figure>
          <a href={url(c.img)} target="_blank" rel="noopener" class="block overflow-hidden rounded-2xl border border-line" aria-label={`${t.viewCert}: ${c[lang]}`}>
            <img src={url(c.img)} alt={c.en} loading="lazy" width="1400" height="990" class="w-full transition duration-300 hover:scale-[1.02]" />
          </a>
          <figcaption class="mt-4">
            <p class="font-display text-lg font-bold">{c[lang]}</p>
            <p class="text-sm text-muted">{c.by} · {c.when}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="mx-auto max-w-6xl px-5 py-24">
  <h2 class="font-display text-5xl font-extrabold tracking-tight sm:text-6xl">{t.contactTitle}</h2>
  <p class="mt-4 max-w-xl text-lg text-muted">{t.contactIntro}</p>
  <div class="mt-10 flex flex-wrap items-center gap-3">
    <a href={`mailto:${profile.email}`} class="break-all font-display text-2xl font-bold underline decoration-turmeric decoration-4 underline-offset-8 sm:text-3xl">{profile.email}</a>
    <button type="button" class="btn btn-line text-sm" data-copy={profile.email} data-copied={t.copied}>{t.copy}</button>
  </div>
  <ul class="mt-10 flex flex-wrap gap-3">
    <li><a class="btn btn-line" href={waLink}>{t.whatsapp} · {profile.phone}</a></li>
    <li><a class="btn btn-line" href={profile.linkedin}>LinkedIn</a></li>
    <li><a class="btn btn-line" href={profile.github}>GitHub</a></li>
    <li><a class="btn btn-ink" href={url(profile.cv)} download>{t.downloadCv}</a></li>
  </ul>
</section>

<script>
  // project filter
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((row) => {
      row.hidden = f !== 'all' && row.dataset.cat !== f;
    });
  }));
  // copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(b.dataset.copy ?? '');
      const old = b.textContent;
      b.textContent = b.dataset.copied ?? 'Copied';
      setTimeout(() => (b.textContent = old), 1800);
    } catch { location.href = 'mailto:' + b.dataset.copy; }
  }));
</script>
