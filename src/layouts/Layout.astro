---
import '../styles/global.css';
import { ui, profile, type Lang } from '../data/site';
import { url, page } from '../data/url';

interface Props { lang: Lang; title?: string; description?: string; path?: string; image?: string }
const { lang, title, description, path = '', image = 'images/og.png' } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'si' : 'en';
const pageTitle = title ? `${title} · ${profile.name}` : t.title;
const desc = description ?? t.description;
const canonical = new URL(page(lang, path), Astro.site).href;
const nav = [
  ['work', '#work'], ['all', '#projects'], ['journey', '#journey'], ['skills', '#skills'], ['certs', '#certificates'], ['contact', '#contact'],
] as const;
const home = page(lang);
---
<!doctype html>
<html lang={lang === 'si' ? 'si' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={new URL(page('en', path), Astro.site).href} />
  <link rel="alternate" hreflang="si" href={new URL(page('si', path), Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(url(image), Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1e6a4c" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+Sinhala:wght@400;500;600;700&family=Noto+Serif+Sinhala:wght@600;800&display=swap" rel="stylesheet" />
  <script is:inline>
    try { if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-dvh font-sans antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2">Skip to content</a>
  <header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
      <a href={home} class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight">
        <span class="grid size-8 place-items-center rounded-lg bg-tea font-sinhala text-base text-paper" aria-hidden="true">ම</span>
        {profile.name}
      </a>
      <nav class="ml-auto hidden items-center gap-1 text-sm text-muted lg:flex" aria-label="Sections">
        {nav.map(([k, h]) => <a href={home + h} class="rounded-lg px-3 py-2 hover:bg-surface hover:text-ink">{t.nav[k]}</a>)}
      </nav>
      <div class="ml-auto flex items-center gap-1 lg:ml-2">
        <a href={page(other, path)} class="rounded-lg px-3 py-2 text-sm font-semibold hover:bg-surface" lang={other} hreflang={other}>{t.otherLang}</a>
        <button id="theme" type="button" class="grid size-9 place-items-center rounded-lg hover:bg-surface" aria-label={t.theme}>
          <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"/></svg>
          <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {profile.fullName} ({profile.name})</p>
      <p>{t.footer} <a class="link" href="https://github.com/malingaprabhath7-maker/malinga-portfolio">Source</a></p>
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme').addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  </script>
</body>
</html>
