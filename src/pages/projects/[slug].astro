---
import Layout from '../../layouts/Layout.astro';
import ProjectPage from '../../components/ProjectPage.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<Layout lang="en" title={project.name} description={project.en.summary} path={`projects/${project.slug}`} image={project.images?.[0]?.src}>
  <ProjectPage lang="en" project={project} />
</Layout>
